{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "//#typecheck:minimum": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
