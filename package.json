{
  "name": "light-sdk-builder-workspace",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "check": "turbo run build test typecheck typecheck:minimum",
    "typecheck": "tsc -p test/types/tsconfig.json",
    "typecheck:minimum": "node node_modules/typescript-minimum/bin/tsc -p test/types/tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test:package": "node scripts/verify-package.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only --ignore-scripts",
    "release:pack": "changeset pack --out-dir artifacts/release",
    "release:check": "node scripts/verify-package.mjs --pack-dir artifacts/release"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tanstack/query-core": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@types/react": "19.3.0",
    "light-sdk-builder": "workspace:*",
    "light-sdk-builder-tanstack-query": "workspace:*",
    "oxfmt": "0.75.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "typescript-minimum": "npm:typescript@5.5.4",
    "valibot": "1.5.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
